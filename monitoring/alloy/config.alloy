logging { level = "warn" }
local.file_match "apps" {
  path_targets = [
    {"__path__" = "/logs/api.log", "service" = "api"},
    {"__path__" = "/logs/publication-recovery.log", "service" = "publication-recovery"},
    {"__path__" = "/logs/pre-send.log", "service" = "pre-send"},
    {"__path__" = "/logs/skt-sender.log", "service" = "skt-sender"},
    {"__path__" = "/logs/kt-sender.log", "service" = "kt-sender"},
    {"__path__" = "/logs/lgu-sender.log", "service" = "lgu-sender"},
    {"__path__" = "/logs/webhook-receive.log", "service" = "webhook-receive"},
    {"__path__" = "/logs/result-manager.log", "service" = "result-manager"},
    {"__path__" = "/logs/complete-manager.log", "service" = "complete-manager"},
    {"__path__" = "/logs/webhook-sender.log", "service" = "webhook-sender"},
    {"__path__" = "/logs/tcp-sender.log", "service" = "tcp-sender"},
  ]
}
loki.source.file "apps" {
  targets = local.file_match.apps.targets
  forward_to = [loki.process.app_logs.receiver]
}
loki.process "app_logs" {
  stage.json {
    expressions = { ts = "\"@timestamp\"" }
  }
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }
  stage.label_drop { values = ["filename"] }
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}
