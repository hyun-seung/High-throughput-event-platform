{
  "uid": "messaging-trace",
  "title": "메시징 서비스 · 메시지 추적",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "10s",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "clientMsgId로 AP 로그 찾기",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "platform-loki"
      },
      "targets": [
        {
          "expr": "{service=~\".+\"} |~ \"$clientMsgId\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true
      }
    },
    {
      "id": 2,
      "title": "메시징 토픽별 누적 offset",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic) (platform_kafka_log_end_offset{topic=~\"message.*|MSG_RESULT|MSG-RESULT-FINALIZED|WEBHOOK-SEND\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "links": [
    {
      "title": "overview",
      "url": "/d/messaging-overview",
      "type": "link"
    },
    {
      "title": "services",
      "url": "/d/messaging-services",
      "type": "link"
    },
    {
      "title": "providers",
      "url": "/d/messaging-providers",
      "type": "link"
    },
    {
      "title": "customers",
      "url": "/d/messaging-customers",
      "type": "link"
    },
    {
      "title": "errors",
      "url": "/d/messaging-errors",
      "type": "link"
    },
    {
      "title": "infra",
      "url": "/d/messaging-infra",
      "type": "link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "clientMsgId",
        "type": "textbox",
        "label": "clientMsgId",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  }
}
