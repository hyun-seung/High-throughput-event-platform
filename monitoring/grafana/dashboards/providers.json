{
  "uid": "messaging-providers",
  "title": "메시징 서비스 · 통신사·2차 발송",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "10s",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "통신사 발송 시도 TPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (carrier,outcome) (rate(messaging_carrier_http_attempts_total{job=~\"skt-sender|kt-sender|lgu-sender\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "통신사 HTTP 응답 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,carrier) (rate(messaging_carrier_http_duration_seconds_bucket{job=~\"skt-sender|kt-sender|lgu-sender\"}[$__rate_interval])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "통신사별 명령 대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic, group) (platform_kafka_committed_lag{group=~\"messaging-(skt|kt|lgu)-http-sender\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "2차 TCP 명령 TPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(platform_kafka_log_end_offset{topic=\"message.tcp.requested.v1\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Sender 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=~\"skt-sender|kt-sender|lgu-sender|tcp-sender\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
