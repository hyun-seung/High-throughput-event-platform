{
  "uid": "messaging-services",
  "title": "메시징 서비스 · AP 상태",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "10s",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "AP 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=~\"api|pre-send|skt-sender|kt-sender|lgu-sender|webhook-receive|result-manager|complete-manager|webhook-sender|tcp-sender\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "프로세스 CPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=~\"api|pre-send|skt-sender|kt-sender|lgu-sender|webhook-receive|result-manager|complete-manager|webhook-sender|tcp-sender\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "JVM heap 사용량",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\",job=~\"api|pre-send|skt-sender|kt-sender|lgu-sender|webhook-receive|result-manager|complete-manager|webhook-sender|tcp-sender\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "API·웹훅 HTTP 응답",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (job,status) (rate(http_server_requests_seconds_count{job=~\"api|webhook-receive\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Kafka 소비 지연",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic, group) (platform_kafka_committed_lag{group=~\"messaging-.*\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
