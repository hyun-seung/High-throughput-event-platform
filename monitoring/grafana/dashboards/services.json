  "panels": [
    {
      "id": 1,
      "title": "서비스별 처리량 · 지연 · 자원",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "PPT의 EKS 서비스 화면을 현재 실행 중인 앱 단위로 구성했습니다. CPU는 프로세스 사용률, JVM heap은 실제 사용량입니다. Pod/노드 재시작 횟수는 EKS 연결 전에는 표시하지 않습니다."
      }
    },
    {
      "id": 2,
      "title": "서비스 UP",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"api|ingress|dispatch|simulator\"}",
          "legendFormat": "{{stage}}",
          "range": false,
          "instant": true,
          "format": "table"
