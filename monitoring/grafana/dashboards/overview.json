{
  "uid": "messaging-overview",
  "title": "메시징 서비스 · 통합 관제",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "10s",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "메시지 인입 TPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api\",uri=\"/api/v1/messages\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "단계별 Kafka 발행 TPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic) (rate(platform_kafka_log_end_offset{topic=~\"message.received.v1|message.skt.http.send.v1|message.kt.http.send.v1|message.lgu.http.send.v1|MSG_RESULT|MSG-RESULT-FINALIZED|WEBHOOK-SEND\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "업무 소비 지연",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic, group) (platform_kafka_committed_lag{group=~\"messaging-.*\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "AP 수집 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=~\"api|pre-send|skt-sender|kt-sender|lgu-sender|webhook-receive|result-manager|complete-manager|webhook-sender|tcp-sender\"}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "고객 웹훅 결과",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(messaging_webhook_attempts_total{job=\"webhook-sender\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "1차 HTTP 발송 결과",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (carrier,outcome) (rate(messaging_carrier_http_attempts_total{job=~\"skt-sender|kt-sender|lgu-sender\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "links": [
    {
      "title": "services",
      "url": "/d/messaging-services",
      "type": "link"
    },
    {
      "title": "providers",
      "url": "/d/messaging-providers",
      "type": "link"
    },
    {
      "title": "customers",
      "url": "/d/messaging-customers",
      "type": "link"
    },
    {
      "title": "errors",
      "url": "/d/messaging-errors",
      "type": "link"
    },
    {
      "title": "infra",
      "url": "/d/messaging-infra",
      "type": "link"
    },
    {
      "title": "trace",
      "url": "/d/messaging-trace",
      "type": "link"
    }
  ],
  "templating": {
    "list": []
  }
}
