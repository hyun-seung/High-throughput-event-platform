{
  "uid": "messaging-errors",
  "title": "메시징 서비스 · 오류·경보",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "10s",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "인입 HTTP 상태",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"api\",uri=\"/api/v1/messages\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "통신사 실패·무응답",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (carrier,outcome) (rate(messaging_carrier_http_attempts_total{outcome=~\"FAILED|TIMEOUT|EXCEPTION\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "고객 웹훅 재시도·소진",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(messaging_webhook_attempts_total{outcome=~\"retry|exhausted\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "활성 경보",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (alertname) (ALERTS{alertstate=\"firing\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "AP 경고·오류 로그",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "platform-loki"
      },
      "targets": [
        {
          "expr": "{service=~\".+\"} | json | level=~\"WARN|ERROR\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 11
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true
      }
    }
  ],
  "links": [
    {
      "title": "overview",
      "url": "/d/messaging-overview",
      "type": "link"
    },
    {
      "title": "services",
      "url": "/d/messaging-services",
      "type": "link"
    },
    {
      "title": "providers",
      "url": "/d/messaging-providers",
      "type": "link"
    },
    {
      "title": "customers",
      "url": "/d/messaging-customers",
      "type": "link"
    },
    {
      "title": "infra",
      "url": "/d/messaging-infra",
      "type": "link"
    },
    {
      "title": "trace",
      "url": "/d/messaging-trace",
      "type": "link"
    }
  ],
  "templating": {
    "list": []
  }
}
