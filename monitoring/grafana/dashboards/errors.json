{
  "uid": "delivery-errors",
  "title": "발송 관제 · 오류코드",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "delivery-platform"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "현재 코드 체계",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "현재는 mock-provider의 HTTP 상태 코드·전송 오류와 API Kafka 발행 오류를 표시합니다. PPT의 71010/79998 등 통신사 코드는 업체 프로토콜이 정해진 뒤 추가합니다. zone=local이며 A/C 존 구분은 미연결입니다."
      }
    },
    {
      "id": 2,
      "title": "업체·단계·오류코드별 관측",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 9
      },
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "platform-loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,stage,code,outcome) (count_over_time({service=~\"api|ingress|dispatch\",zone=\"local\"} | json provider=\"provider\",stage=\"stage\",code=\"code\",outcome=\"outcome\" | outcome=~\"http_error|transport_error|publish_unconfirmed|review_required\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "관측 횟수",
              "tenantId": "고객 ID",
              "provider": "업체",
              "stage": "구간",
              "code": "코드",
              "outcome": "분류"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "API 응답 상태별 요청",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(http_server_requests_seconds_count{application=\"delivery-api\",uri=\"/api/v1/deliveries\"}[$__range]))",
          "legendFormat": "{{stage}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "zone": true,
              "service": true
            },
            "renameByName": {
              "Value": "값",
              "job": "대상",
              "application": "앱",
              "client_id": "Consumer",
              "stage": "구간",
              "status": "HTTP 상태",
              "alertname": "경보",
              "alertstate": "상태",
              "severity": "심각도"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "DB 일반 오류와 조건 불일치",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "데이터 없음",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,result) (rate(delivery_dynamodb_duration_seconds_count{result!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} · {{result}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "최근 오류 관측",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "platform-loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"api|ingress|dispatch\",zone=\"local\"} | json | outcome=~\"http_error|transport_error|publish_unconfirmed|review_required\" | line_format \"{{.stage}} · {{.outcome}} | deliveryId={{.deliveryId}} | tenant={{.tenantId}} | attempt={{.attemptId}} | {{.provider}} {{.code}}\"",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "links": [
    {
      "title": "통합 관제",
      "url": "/d/delivery-overview",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "서비스",
      "url": "/d/delivery-services",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "외부 업체",
      "url": "/d/delivery-providers",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "고객",
      "url": "/d/delivery-customers",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "오류코드",
      "url": "/d/delivery-errors",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "인프라",
      "url": "/d/delivery-infra",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "메시지 추적",
      "url": "/d/delivery-trace",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(255, 96, 96, 1)"
      }
    ]
  }
}
