{
  "uid": "messaging-customers",
  "title": "메시징 서비스 · 고객 웹훅",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "10s",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "고객 웹훅 발송 결과",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(messaging_webhook_attempts_total{job=\"webhook-sender\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "고객 웹훅 HTTP 지연 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(messaging_webhook_http_duration_seconds_bucket{job=\"webhook-sender\"}[$__rate_interval])))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "웹훅 묶음 크기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "rate(messaging_webhook_batch_size_sum{job=\"webhook-sender\"}[$__rate_interval]) / clamp_min(rate(messaging_webhook_batch_size_count{job=\"webhook-sender\"}[$__rate_interval]), 0.001)",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "웹훅 명령 대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "platform-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic, group) (platform_kafka_committed_lag{group=\"messaging-webhook-sender\"})",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "links": [
    {
      "title": "overview",
      "url": "/d/messaging-overview",
      "type": "link"
    },
    {
      "title": "services",
      "url": "/d/messaging-services",
      "type": "link"
    },
    {
      "title": "providers",
      "url": "/d/messaging-providers",
      "type": "link"
    },
    {
      "title": "errors",
      "url": "/d/messaging-errors",
      "type": "link"
    },
    {
      "title": "infra",
      "url": "/d/messaging-infra",
      "type": "link"
    },
    {
      "title": "trace",
      "url": "/d/messaging-trace",
      "type": "link"
    }
  ],
  "templating": {
    "list": []
  }
}
