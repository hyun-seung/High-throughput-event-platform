<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.side.project.messaging</groupId>
        <artifactId>platform</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>messaging-reference-cache</artifactId>
    <dependencies>
        <!-- Linux TCP_USER_TIMEOUT for Redis endpoint replacement, one JAR for both deployment architectures. -->
        <dependency>
            <groupId>io.netty</groupId><artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-aarch_64</classifier><scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId><artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier><scope>runtime</scope>
        </dependency>

        <dependency><groupId>org.side.project.messaging</groupId><artifactId>messaging-common</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-kafka</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>
</project>
