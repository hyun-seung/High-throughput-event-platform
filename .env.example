# Local development only. Copy to .env; scripts/local.sh loads it.
KAFKA_HOST_PORT=19092
REDIS_HOST_PORT=16379
POSTGRES_HOST_PORT=15432
DYNAMODB_HOST_PORT=18000
DEBEZIUM_HOST_PORT=18083
MESSAGE_API_PORT=18080
MESSAGE_API_METRICS_PORT=19080
MESSAGING_REFERENCE_CACHE_PORT=8098
MESSAGING_REFERENCE_CACHE_METRICS_PORT=19088
MSG_COMPLETE_MANAGER_PORT=8103
MSG_COMPLETE_MANAGER_METRICS_PORT=19095
MSG_COMPLETE_DB_SCHEMA=messaging_completion
MSG_COMPLETE_CONSUMER_ENABLED=true
MSG_COMPLETE_CLEANUP_ENABLED=true
MSG_COMPLETE_CLEANUP_RETENTION=7d
MSG_WEBHOOK_SENDER_PORT=8104
MSG_WEBHOOK_SENDER_METRICS_PORT=19096
MSG_WEBHOOK_DB_SCHEMA=messaging_webhook
MSG_WEBHOOK_SENDER_ENABLED=true
MSG_TCP_SENDER_PORT=8105
MSG_TCP_SENDER_METRICS_PORT=19097
MSG_TCP_SENDER_ENABLED=true
MSG_RESULT_OUTBOX_ENABLED=true
MSG_TCP_PROVIDER_HOST=127.0.0.1
MSG_TCP_PROVIDER_PORT=18091
MESSAGING_ADMISSION_ENABLED=true
# For messaging-carrier-http-sender, set separately for each SKT/KT/LGU process:
# MSG_HTTP_CARRIER=SKT
# MSG_HTTP_BASE_URL=<carrier URL>
# MSG_HTTP_NOT_OUR_CARRIER_CODES=66001
# MSG_HTTP_TPS_EXCEEDED_CODES=66002
# MSG_HTTP_SENDER_PORT=8101
# MSG_HTTP_SENDER_METRICS_PORT=19091
# Set messaging.webhook.sender.customers.<clientId>.url in external YAML for customer webhooks.
# TCP framing is provisional until the provider specification is confirmed.
KAFKA_RECONNECT_BACKOFF_MS=500
KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
KAFKA_RETRY_BACKOFF_MS=500
KAFKA_RETRY_BACKOFF_MAX_MS=10000
KAFKA_SOCKET_SETUP_TIMEOUT_MS=5000
KAFKA_SOCKET_SETUP_TIMEOUT_MAX_MS=10000
