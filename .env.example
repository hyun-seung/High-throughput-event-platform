# Local development only. Copy to .env; scripts/local.sh loads it.
# Isolated ports avoid existing host services.
KAFKA_HOST_PORT=19092
REDIS_HOST_PORT=16379
POSTGRES_HOST_PORT=15432
DYNAMODB_HOST_PORT=18000
DELIVERY_API_PORT=18080
MOCK_PROVIDER_PORT=18090
MOCK_TCP_PORT=18091
RECEIPT_API_PORT=18094
# Empty secrets disable that provider. Set different random secrets, 32-256 ASCII characters.
RECEIPT_PRIMARY_SECRET=
RECEIPT_SECONDARY_SECRET=
# Loopback management ports. API metrics require the same JWT as delivery requests.
DELIVERY_API_METRICS_PORT=19080
INGRESS_METRICS_PORT=19081
DISPATCH_METRICS_PORT=19082
SIMULATOR_METRICS_PORT=19090
RECEIPT_METRICS_PORT=19084
RESULT_METRICS_PORT=19085
RESULT_HTTP_PORT=8095
RESULT_DB_SCHEMA=delivery_results
RESULT_CONCURRENCY=3
# Enable only after all ingress/dispatch/receipt workers implement the completion fence and marker tracking.
DELIVERY_CLEANUP_ENABLED=false
DELIVERY_CLEANUP_POLL_MS=1000
# Configure notification.customers.<tenantId>.url/token in an external config before enabling.
CUSTOMER_NOTIFICATIONS_ENABLED=false
CUSTOMER_NOTIFICATION_CONCURRENCY=4
CUSTOMER_NOTIFICATION_POLL_MS=100
CUSTOMER_NOTIFICATION_HTTP_TIMEOUT=3s
CUSTOMER_NOTIFICATION_LEASE=30s
CUSTOMER_NOTIFICATION_RETRY_DELAY=1s
CUSTOMER_NOTIFICATION_MAX_RETRY_DELAY=60s
# Worker HTTP servers have no business API; management endpoints use the ports above.
INGRESS_HTTP_PORT=8091
DISPATCH_HTTP_PORT=8092
# Worker comparisons preserve RECORD acknowledgments and durable handoff.
INGRESS_CONCURRENCY=3
DISPATCH_CONCURRENCY=3
# Retry decisions persist their original deadline; these are development defaults.
# Enable only after installing lifecycle_due_v1 and backfilling known active IDs.
DISPATCH_LIFECYCLE_ENABLED=false
DISPATCH_PRIMARY_TTL=3h
SECONDARY_TTL=4h
SECONDARY_PROVIDER=tcp-provider
DISPATCH_NO_RESPONSE_RETRY_DELAY=1s
INGRESS_KAFKA_LINGER_MS=5
# Simulator evidence is process-local and bounded; restart between independent runs.
SIMULATOR_RESPONSE_DELAY_MILLIS=0
SIMULATOR_DEDUPLICATE=false
SIMULATOR_MAX_TRACKED_KEYS=200000
# Customer HTTP receiver: /api/v1/customer-results/<tenantId>/<ACK|FAIL_ONCE|REJECT|ACK_THEN_503|DELAY_ACK>
SIMULATOR_CUSTOMER_RESULTS_ENABLED=false
CUSTOMER_RESULT_SIMULATOR_SECRET=
# Automatic provider webhooks are opt-in. Uses the distinct RECEIPT_*_SECRET values above.
SIMULATOR_RECEIPTS_ENABLED=false
SIMULATOR_RECEIPTS_PRIMARY_URL=http://127.0.0.1:18094/api/v1/receipts/mock-provider
SIMULATOR_RECEIPTS_SECONDARY_URL=http://127.0.0.1:18094/api/v1/receipts/tcp-provider
# Base64-encoded key; decoded length must be at least 32 bytes. Local use only.
JWT_SECRET=bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1zZWNyZXQtYXQtbGVhc3QtMzItYnl0ZXMtbG9uZw==
# Optional override. By default builds use ./mvnw (Maven 3.9.16).
# MAVEN_BIN=/Applications/IntelliJ IDEA.app/Contents/plugins/maven-plugin/lib/maven3/bin/mvn
