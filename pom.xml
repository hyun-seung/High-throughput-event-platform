<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>org.side.project.event</groupId>
    <artifactId>platform</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>reliable-event-delivery-platform</name>
    <description>Reliable Event Delivery Platform</description>

    <modules>
        <module>common-core</module>
        <module>auth-module</module>
        <module>event-api</module>
        <module>common-security</module>
        <module>event-common</module>
        <module>delivery-ingress-worker</module>
        <module>dispatch-worker</module>
        <module>external-api-simulator</module>
        <module>receipt-api</module>
        <module>delivery-result-worker</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jjwt.version>0.13.0</jjwt.version>
        <aws.sdk.version>2.54.12</aws.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>integration-tests</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions><execution>
                    <id>require-integration-environment</id>
                    <goals><goal>enforce</goal></goals>
                    <configuration><rules>
                        <requireProperty><property>env.DYNAMODB_TEST_ENDPOINT</property><regex>http://(localhost|127\.0\.0\.1):[0-9]+</regex><message>Use scripts/test-java.sh integration or supply an isolated local DynamoDB.</message></requireProperty>
                        <requireProperty><property>env.KAFKA_TEST_BOOTSTRAP_SERVERS</property><regex>(localhost|127\.0\.0\.1):[0-9]+</regex></requireProperty>
                        <requireProperty><property>env.POSTGRES_TEST_URL</property><regex>jdbc:postgresql://(localhost|127\.0\.0\.1):[0-9]+/[^?]+</regex></requireProperty>
                        <requireProperty><property>env.REDIS_TEST_PORT</property><regex>[0-9]+</regex></requireProperty>
                    </rules></configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>require-java-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Java 21 is required. Set JAVA_HOME to a JDK 21 installation.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
